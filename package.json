{
  "name": "my-bookshelf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js --production",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "d1:create": "npx wrangler d1 create my-bookshelf",
    "d1:migrate:local": "npx wrangler d1 migrations apply my-bookshelf --local",
    "d1:migrate:remote": "npx wrangler d1 migrations apply my-bookshelf --remote",
    "d1:export-local": "node scripts/export-d1.js",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.3.0",
    "vite": "^6.2.7"
  }
}
