{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-bookshelf-api",
	"main": "worker/index.js",
	"compatibility_date": "2026-11-17",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://akeylahhernandez.github.io,http://localhost:5173"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-bookshelf",
			"database_id": "4d963517-4f96-47ad-8fde-315de413c470"
		}
	]
}
